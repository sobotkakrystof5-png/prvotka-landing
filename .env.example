# Vzor proměnných prostředí. Skutečné hodnoty jen ve Vercelu nebo v .env.local (necommitovat).
# Nikdy s prefixem NEXT_PUBLIC_ kromě NEXT_PUBLIC_TURNSTILE_SITE_KEY (veřejný klíč). Ostatní jsou serverová.

# Resend API klíč (tajné)
RESEND_API_KEY=
# Kam chodí poptávky z formuláře  [E-MAIL PRO POPTÁVKY]
CONTACT_TO_EMAIL=krystof@prvotka.cz
# Odesílatel z ověřené domény v Resend, např. "Poptávky <poptavky@prvotka.cz>"
CONTACT_FROM_EMAIL=krystof@prvotka.cz

# ---------------------------------------------------------------------------
# DEMO (/demo). Bez DEMO_ENABLED=true je demo vypnuté a nic z níže uvedeného se nevyžaduje.
# Se zapnutým demem chybějící proměnná zastaví start serveru (src/instrumentation.ts).
# RESEND_API_KEY výše sdílí web i demo.
# ---------------------------------------------------------------------------
DEMO_ENABLED=false
# Strop vytěžení za den pro celé demo (ochrana nákladů)
DEMO_DAILY_EXTRACTION_CAP=

# Neon: jen větev nebo projekt pro demo, nikdy ostrá databáze (tajné)
DATABASE_URL=
# Hostitel z DATABASE_URL demo větve (např. ep-…-pooler.….neon.tech). Pojistka migrací.
DEMO_DATABASE_HOST=

# Úložiště souborů: r2 | memory (memory jen pro vývoj, v produkci se odmítne)
STORAGE_DRIVER=memory
STORAGE_R2_ACCOUNT_ID=
STORAGE_R2_ACCESS_KEY_ID=
STORAGE_R2_SECRET_ACCESS_KEY=
STORAGE_BUCKET=

# Claude API (tajné) a model pro vytěžení (ověřit v dokumentaci Anthropic)
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=

# Oznámení o nových leadech a vyčerpání dema
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

# Cloudflare Turnstile: secret jen na serveru, site key smí do prohlížeče
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Náhodné řetězce, aspoň 32 znaků (např. openssl rand -base64 48) (tajné)
SESSION_SECRET=
CRON_SECRET=
